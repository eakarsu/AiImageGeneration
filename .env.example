NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/image_generation
JWT_SECRET=generate_a_unique_random_value_of_at_least_32_characters
ENABLE_LEGACY_PROVIDER_ROUTES=false
ENABLE_LEGACY_PUBLIC_INTAKE=false
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false
OPENROUTER_API_KEY=
MEDIA_MODEL_TOKEN=
RIGHTS_LIBRARY_TOKEN=
STORAGE_CDN_TOKEN=
PUBLISHING_TOKEN=
PAYMENT_PROVIDER_TOKEN=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
